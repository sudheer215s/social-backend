# Copy to .env for local runs of hello-service (never commit real secrets).
# From a clean clone: bash scripts/dev-setup.sh

NODE_ENV=development
SERVICE_NAME=hello-service
LOG_LEVEL=info
PORT=3000

# Postgres via PgBouncer (Compose)
DATABASE_URL=postgres://social:social@localhost:6432/social
DATABASE_POOL_MAX=5

REDIS_URL=redis://localhost:6379

# Redpanda Kafka API — host processes use 19092; containers use redpanda:9092
KAFKA_BROKERS=localhost:19092

# OTLP HTTP → OpenTelemetry Collector (Compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional local references (not required by platform-config yet)
# ELASTICSEARCH_URL=http://localhost:9200
# JAEGER_UI=http://localhost:16686

# Identity JWT (defaults work for local)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=api

# api-gateway → identity
IDENTITY_BASE_URL=http://127.0.0.1:3001
IDENTITY_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json

# Gateway rate limit (auth routes)
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SEC=60
# Set REDIS_DISABLED=1 to skip Redis (fail-open revocation, memory rate limit)
# REDIS_DISABLED=0

# Domain HTTP (gateway proxies)
POST_BASE_URL=http://127.0.0.1:3002
GRAPH_BASE_URL=http://127.0.0.1:3003
# Identity gRPC
IDENTITY_GRPC_URL=127.0.0.1:50051
IDENTITY_USE_GRPC=0
