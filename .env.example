# Copy to .env for local runs of hello-service (never commit real secrets).
NODE_ENV=development
SERVICE_NAME=hello-service
LOG_LEVEL=info
PORT=3000

# Postgres (via PgBouncer in Compose later)
DATABASE_URL=postgres://social:social@localhost:6432/social
DATABASE_POOL_MAX=5

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
