# Copy to .env for local overrides (never commit .env).
# Compose reads docker/* env; services also accept these when run via pnpm dev:*.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Data plane (host ports when using pnpm compose:up) ---
DATABASE_URL=postgres://social:social@127.0.0.1:6432/social
DATABASE_POOL_MAX=5
REDIS_URL=redis://127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:19092
ELASTICSEARCH_URL=http://127.0.0.1:9200
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- Service discovery (host-side local dev) ---
IDENTITY_BASE_URL=http://127.0.0.1:3001
IDENTITY_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
IDENTITY_GRPC_URL=127.0.0.1:50051
POST_BASE_URL=http://127.0.0.1:3002
GRAPH_BASE_URL=http://127.0.0.1:3003
TIMELINE_BASE_URL=http://127.0.0.1:3004
NOTIFICATION_BASE_URL=http://127.0.0.1:3005
SEARCH_BASE_URL=http://127.0.0.1:3006
REALTIME_BASE_URL=http://127.0.0.1:3007
GATEWAY_URL=http://127.0.0.1:3000

# JWT (must match identity issuer)
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=api

# Realtime hydrate token (must match notification + realtime)
REALTIME_SERVICE_TOKEN=local-dev-realtime-token

# --- Tuning (optional) ---
# LARGE_ACCOUNT_FOLLOWER_THRESHOLD=10000
# ERASURE_WORKER_INTERVAL_MS=60000
# ERASURE_WORKER_DISABLED=0
# COUNTER_RECONCILE_INTERVAL_MS=300000
# COUNTER_RECONCILE_DISABLED=0
# CASCADE_WORKER_INTERVAL_MS=2000
# CASCADE_WORKER_DISABLED=0
# KAFKA_DISABLED=0
# REDIS_DISABLED=0
