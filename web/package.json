{
  "name": "@social/web",
  "version": "0.0.1",
  "private": true,
  "description": "Web client — Next.js App Router (docs/frontend)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0 && node ./scripts/assert-lint-boundaries.mjs",
    "test": "vitest run && node ./scripts/assert-lint-boundaries.mjs",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../openapi/openapi.json -o ./api-client/generated/schema.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "msw": "^2.15.0",
    "next": "^15.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "postcss": "^8.5.25",
    "tailwindcss": "3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
