{
  "name": "@social/web",
  "version": "0.0.1",
  "private": true,
  "description": "Web client — Next.js App Router (docs/frontend)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'web lint deferred to F0-T03 (layer boundaries)'",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../openapi/openapi.json -o ./api-client/generated/schema.ts"
  },
  "dependencies": {
    "next": "^15.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
