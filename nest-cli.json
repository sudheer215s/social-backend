{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/hello-service/src",
  "monorepo": true,
  "root": "apps/hello-service",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/hello-service/tsconfig.build.json"
  },
  "projects": {
    "hello-service": {
      "type": "application",
      "root": "apps/hello-service",
      "entryFile": "main",
      "sourceRoot": "apps/hello-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hello-service/tsconfig.build.json"
      }
    }
  }
}
