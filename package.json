{
  "name": "social-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Distributed Social Media Backend — NestJS monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "dev": "turbo run dev --filter=@social/hello-service",
    "compose:up": "docker compose -f docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f docker/docker-compose.yml down",
    "compose:ps": "docker compose -f docker/docker-compose.yml ps",
    "compose:check": "bash scripts/check-compose.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
